{
  "name": "cookiejev",
  "version": "0.1.0",
  "description": "Cookie consent autopilot for Chrome and Edge, powered by the OpenJev decision model.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node scripts/build.mjs --watch",
    "icons": "node scripts/gen-icons.mjs",
    "zip": "node scripts/zip.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src tests scripts --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "archiver": "^7.0.1",
    "esbuild": "^0.25.0",
    "eslint": "^9.30.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.40.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
